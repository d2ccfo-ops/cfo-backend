{
  "name": "cfo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && tsc --noEmit",
    "test:watch": "vitest",
    "check:integration": "failed=\"\"; for f in scripts/check*.ts; do echo \"--- $f ---\"; npx tsx \"$f\" || failed=\"$failed $f\"; done; if [ -n \"$failed\" ]; then echo; echo \"FAILED SCRIPTS:$failed\"; exit 1; fi; echo; echo \"all integration checks passed\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "eval": "tsx eval/run.ts",
    "eval:list": "tsx eval/run.ts --list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@clerk/express": "^2.1.51",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fast-xml-parser": "^5.10.1",
    "ioredis": "^5.4.2",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "read-excel-file": "^9.3.10",
    "svix": "^1.99.1",
    "zod": "^3.24.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
