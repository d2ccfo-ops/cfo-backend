// Core canonical schema for CFOOS.
// Rules baked into this schema on purpose:
//  - All money columns are BigInt paise (never Float/Decimal-as-float) — see modules/calc/money.ts.
//  - Every tenant-scoped table carries organizationId (and legalEntityId where the data is
//    entity-specific) so every query can be scoped without relying on joins to infer tenancy.
//  - Raw provider payloads are stored immutably on RawEvent before any processing, and processing
//    is idempotent via the (connectionId, externalEventId) unique constraint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique // Clerk is the source of truth for org identity/membership
  name       String
  // §3. IANA zone that every reporting window is cut on. Not cosmetic: with
  // windows cut on UTC, "Today" began at 05:30 IST and silently dropped the
  // first 5½ hours of the Indian business day — 4 of 50 orders and 26% of
  // revenue on a measured day. Defaults to IST because that is where this
  // product's merchants are; per-org because their accountants aren't always.
  timezone   String   @default("Asia/Kolkata")
  // P2.0: org-wide settings, as opposed to DashboardLayout below (per-USER).
  // One JSON bag rather than a column per setting, because the known
  // consumers land on different plan items over multiple sessions (the
  // cash-threshold anomaly rule now, notification digests and recurring
  // outflows later) — a new setting is a key, not a migration. Validated on
  // write by routes/preferences.ts's orgSettingsSchema, which is the actual
  // source of truth for which keys exist; this column has none of its own.
  settings   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  legalEntities LegalEntity[] @relation("OrgLegalEntities")

  @@map("organizations")
}

// Which metric cards a user has pinned to a page, and in what order.
//
// Server-side on purpose: this is the one piece of dashboard state that has to
// follow the person rather than the browser. A founder who curates the Overview
// on a laptop and opens it on a phone should find the same cards in the same
// order — localStorage cannot do that. (The date filter is the opposite case
// and stays client-side: it is a transient "what am I looking at right now",
// and having it follow you across devices would be surprising.)
//
// Keyed by userId AND organizationId: the same person advising two brands wants
// a different dashboard for each, and inheriting one org's layout into another
// would leak a signal about how they read the other business.
model DashboardLayout {
  id             String   @id @default(cuid())
  organizationId String
  userId         String // Clerk user id, from the verified session claim
  page           String // "overview" today; the model is page-agnostic on purpose
  // Ordered card identities. Order IS the data — index 0 renders first.
  // Absence of a card means the user removed it, which is why this replaces the
  // default set wholesale rather than merging with it.
  cardOrder      String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, page])
  @@map("dashboard_layouts")
}

model LegalEntity {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  gstin          String?
  pan            String?
  category       String?
  // The last two onboarding fields. Self-reported bands, not measurements —
  // revenueRange is only ever a sanity check against what the connectors
  // actually observe, and primaryChannel seeds channel expectations before any
  // connector exists. Both nullable: an org that skipped onboarding, or one
  // created before these columns existed, is a normal state, not an error.
  revenueRange   String?
  primaryChannel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation("OrgLegalEntities", fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("legal_entities")
}

// §12.2's seven roles. MEMBER is the eighth value and is kept deliberately:
// Postgres enum values can be added additively but not removed without a table
// rewrite, and every membership row in this database currently carries it.
// middleware/rbac.ts maps MEMBER to ANALYST wherever a decision is made, so
// nothing has to know about the legacy value except that one function.
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  // Signs off on money movements and can act on findings, but cannot touch
  // credentials — a connector token is the keys to the business.
  FINANCE_MANAGER
  // Enters and restamps costs. The one write this role has that
  // FINANCE_MANAGER does not need to be granted separately.
  ACCOUNTANT
  // Reads everything and can run what-ifs. What MEMBER always meant.
  ANALYST
  // A read-only guest with no ability to spend anything — not even a model
  // call. Brought in to look at the books, not to work in them.
  EXTERNAL_CA
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  clerkUserId    String
  email          String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  // Last time this person made an authenticated request, for "who is actually
  // using this" on the internal console.
  //
  // A column rather than a derivation, because the obvious derivation is
  // wrong: AuditLog only records WRITES, so a founder who reads dashboards
  // every morning and changes nothing looks dormant in it. Undercounting
  // exactly the behaviour the product is for would make every activity figure
  // a lie in the same direction.
  //
  // Written at most once per five minutes per user (middleware/lastSeen.ts) —
  // a write on every request would put a row update in front of all 89 read
  // endpoints to gain five minutes of precision nobody reads.
  lastSeenAt     DateTime?

  @@unique([organizationId, clerkUserId])
  @@index([organizationId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Connections + raw ingestion
// ---------------------------------------------------------------------------

enum Provider {
  SHOPIFY
  RAZORPAY
  META_ADS
  GOOGLE_ADS
  SHIPROCKET
  BANK
  DELHIVERY
  BANK_AA
  AMAZON
  FLIPKART
  CLICKPOST
  ZOHO_BOOKS
  BLUEDART
  GOKWIK
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

// Separate axis from ConnectionStatus above: ConnectionStatus is the
// connection's overall health (has it ever connected, is the credential
// still valid); SyncJobStatus is "what is the background queue doing with
// this connection's sync job right now." A connection can be ACTIVE while
// its most recent sync FAILED (transient API error) without the connection
// itself needing to be torn down.
enum SyncJobStatus {
  IDLE
  QUEUED
  SYNCING
  FAILED
}

model Connection {
  id                String           @id @default(cuid())
  organizationId    String
  legalEntityId     String
  provider          Provider
  status            ConnectionStatus @default(PENDING)
  externalAccountId String?
  credentialsRef    String // reference into secret store — never the raw secret
  lastSyncedAt      DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Background sync queue state — set by routes/connections/index.ts on
  // enqueue and by modules/queue/syncWorker.ts as the job actually runs.
  // See SyncJobStatus above.
  syncStatus    SyncJobStatus @default(IDLE)
  lastSyncError String?

  // Real progress for the in-flight job, not a fake spinner — populated by
  // the worker from an actual Shopify count.json call before it starts (see
  // modules/connectors/shopify/index.ts's pull()), so a client can compute
  // a genuine "X of Y, ~Z left" from measured throughput. Null whenever
  // nothing is running, or when a connector doesn't support progress
  // reporting (most don't yet — see modules/connectors/types.ts's optional
  // ConnectorContext.reportProgress). This — not local browser state — is
  // what lets the frontend correctly show "still syncing" after a page
  // reload or navigating away and back; a sync job outlives any one tab.
  syncProgressCurrent Int?
  syncProgressTotal   Int?
  syncStartedAt       DateTime?

  // Only meaningful for provider: BANK or BANK_AA — an "available cash"
  // figure needs a balance anchor, and nothing else in the schema provides
  // one (BankTransaction only carries movements, not a running balance).
  // Null until the founder sets it (see routes/connections/index.ts's PATCH
  // /:connectionId/opening-balance); a bank connection with no opening
  // balance set is excluded from the available-cash total rather than
  // silently treated as zero — see modules/calc/cash.ts. BANK_AA gets
  // transactions automatically via Setu, but Setu's FI data doesn't include
  // a running balance either (only per-transaction `currentBalance` snapshots
  // that this MVP doesn't parse out — see modules/connectors/setu), so the
  // anchor is still founder-entered for both providers.
  openingBalanceMinor BigInt?
  openingBalanceDate  DateTime?

  syncRuns SyncRun[]

  // Defense-in-depth against duplicate connections from a double-click or a
  // racing callback — application code still does an explicit findFirst
  // before writing (see connections/shopify.ts), since Prisma can't upsert
  // cleanly against a compound key with a nullable member (same issue as
  // MetricSnapshot — see modules/calc/revenue.ts).
  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId])
  @@index([legalEntityId])
  @@map("connections")
}

enum ProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

// Immutable landing zone for every inbound webhook/backfill payload, processed
// idempotently by (connectionId, externalEventId).
model RawEvent {
  id               String           @id @default(cuid())
  organizationId   String
  connectionId     String
  provider         Provider
  externalEventId  String
  eventType        String
  payload          Json
  receivedAt       DateTime         @default(now())
  processedAt      DateTime?
  processingStatus ProcessingStatus @default(PENDING)
  processingError  String?

  @@unique([connectionId, externalEventId])
  @@index([organizationId])
  @@index([processingStatus])
  @@map("raw_events")
}

// ---------------------------------------------------------------------------
// Commerce + payments (canonical, normalized — never mutate history, only append)
// ---------------------------------------------------------------------------

model Order {
  id              String   @id @default(cuid())
  organizationId  String
  legalEntityId   String
  connectionId    String
  externalOrderId String
  orderNumber     String
  channel         String
  status          String
  currency        String   @default("INR")
  // NOTE THE NAME IS MISLEADING and is kept only because renaming a column
  // this widely referenced is a separate change: this is Shopify's
  // `total_price`, i.e. what the customer actually pays — ALREADY net of
  // discounts and INCLUSIVE of tax (these stores run taxes_included = true).
  // It is not "gross" in the spec's sense. See itemsAmount below for the
  // spec's GMV, and modules/calc/revenueLadder.ts for how the two relate.
  grossAmount     BigInt // paise
  discountAmount  BigInt   @default(0)
  taxAmount       BigInt   @default(0)
  placedAt        DateTime
  raw             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // --- Fields below exist to make the CFOOS Backend Finance Engine revenue
  // ladder computable (spec §5–§11, §64, §66–§69). All were already present in
  // the Shopify payload and were simply being dropped on the floor; they're
  // normalised onto columns rather than re-parsed out of `raw` per query
  // because §112 keeps raw and normalised layers separate.

  // §5 GMV — line-item value BEFORE discounts (Shopify total_line_items_price).
  // Sum of the order's line items, stored explicitly so GMV doesn't depend on
  // line-item rows being complete.
  itemsAmount BigInt @default(0) // paise

  // §6/§7/§11 shipping charged TO the customer — revenue, not the cost of
  // shipping (that's LogisticsCost). Must stay separate from itemsAmount or
  // Net Order Value silently omits it.
  shippingAmount BigInt @default(0) // paise

  // §11/§66 revenue-reducing refunds actually processed against this order.
  // Only successful `refund`-kind transactions — a Shopify "void" cancels an
  // uncaptured (usually COD) authorisation and moves no money, so counting it
  // would inflate the refund rate. §13: a return is operational, a refund is
  // financial; this column is the financial one.
  refundedAmount BigInt @default(0) // paise

  // §16/§67 cancellation. Distinct from a refund: a cancel before shipment
  // should recognise no revenue at all rather than revenue-then-refund.
  cancelledAt DateTime?

  // §68 prepaid vs COD mix. COD dominates Indian D2C and drives completely
  // different economics (§29 COD cost, §18 RTO denominator, §51 COD ageing),
  // so it can't be inferred later from a generic status.
  paymentMode String? // PREPAID | COD | UNKNOWN

  // §35/§69 customer identity, for repeat rate and new-customer CAC. The
  // platform's own customer id, not an email — emails change and are PII we
  // have no reason to copy into our own tables.
  customerRef String?

  lineItems OrderLineItem[]
  payments  Payment[]
  shipments Shipment[]
  refunds   Refund[]

  @@unique([connectionId, externalOrderId])
  @@index([organizationId, legalEntityId])
  @@index([placedAt])
  // Repeat-customer rate (§69) groups by customer within an org; without this
  // it's a full scan of every order the org has ever placed.
  @@index([organizationId, customerRef])
  // Every metric endpoint scans "this org's orders in this window" — the
  // revenue ladder alone does it three times per request. Without this
  // composite the planner used the [organizationId, legalEntityId] prefix and
  // heap-filtered placedAt across the org's entire order history.
  @@index([organizationId, placedAt])
  // The reconciliation summary's channel dropdown groups by channel org-wide;
  // this makes it an index-only scan.
  @@index([organizationId, channel])
  @@map("orders")
}

// P2.3a-pre. A dated, individually-identified refund — the prerequisite the
// refund reconciliation leg (§15 leg 6) could not exist without.
//
// Order.refundedAmount already carries a cumulative per-order total, and that
// is enough to reduce revenue (§11/§66). It is NOT enough to reconcile: a
// gateway refund line says "₹1,240 went back on 3 September against payment
// pay_XYZ", and a cumulative order-level total has no date, no id, and no way
// to tell one refund from a second one on the same order. Matching needs
// discrete records on both sides, so this is the discrete record on ours.
//
// One row per refund TRANSACTION that moved money, not per refund object.
// Shopify groups several transactions under one refund, and it is the
// transaction the gateway echoes back — matching at the group level would mean
// summing our side to compare against their rows, which is exactly the
// aggregation that makes a mismatch impossible to localise.
//
// Voids never appear here. A void cancels an uncaptured authorisation
// (overwhelmingly COD in this market) and moves no money at all — 1,981 orders
// in the reference store carry refund records with no successful transaction.
// Treating those as refunds would inflate the refund rate with orders nobody
// ever paid for, and would put thousands of unmatchable rows into a leg whose
// whole purpose is finding the ones that genuinely do not match.
model Refund {
  id               String   @id @default(cuid())
  organizationId   String
  legalEntityId    String?
  connectionId     String
  orderId          String
  // The provider's id for this refund transaction. Unique per connection, and
  // the value a gateway statement can be matched on.
  externalRefundId String
  amount           BigInt // paise, positive — the money that went back
  currency         String   @default("INR")
  // When the money actually moved, not when the refund record was created.
  // The reconciliation window is cut on this.
  processedAt      DateTime
  // Which rail refunded it ("razorpay", "gokwik", "manual"). Kept separate
  // from gatewayRef because the name is reliable and the reference is not.
  gateway          String?
  // The gateway's own identifier where the platform passes one through — a
  // Razorpay refund id, or the payment id it was refunded against. Nullable
  // and often null; the leg falls back to amount+date+order when it is.
  gatewayRef       String?
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalRefundId])
  @@index([organizationId, processedAt])
  @@index([orderId])
  @@map("refunds")
}

model OrderLineItem {
  id          String  @id @default(cuid())
  orderId     String
  sku         String?
  productName String
  quantity    Int
  unitPrice   BigInt // paise
  // paise, unitPrice * quantity — BEFORE discount, and INCLUSIVE of tax when
  // the store prices tax-inclusive (Shopify taxes_included). §5 GMV at line level.
  totalAmount BigInt
  cogsAmount  BigInt? // paise, nullable until COGS mapping is configured

  // Per-line figures the source system states outright, so §40 SKU revenue can
  // be measured instead of allocated. Nullable on purpose: a connector that
  // cannot supply them must never be mistaken for one reporting a genuine zero.
  // When null the calc falls back to §41 revenue-weighted allocation and says
  // so in the response.
  discountAmount    BigInt? // paise, discount attributed to this line
  taxAmount         BigInt? // paise, tax on this line
  // paise, tax-INCLUSIVE, and only money-backed refunds — a void moves no money
  // (§13/§14), so counting it would cut a product's revenue for a sale that was
  // never refunded. Clamped so it can never exceed the order's refunded total.
  refundedAmount    BigInt?
  refundedTaxAmount BigInt? // paise, the tax contained within refundedAmount
  refundedQuantity  Int? // units returned, money-backed refunds only

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_line_items")
}

model Payment {
  id                String    @id @default(cuid())
  organizationId    String
  legalEntityId     String
  connectionId      String
  externalPaymentId String
  orderId           String?
  amount            BigInt // paise
  currency          String    @default("INR")
  method            String?
  status            String
  feeAmount         BigInt? // gateway fee, paise (GST-inclusive, where the provider states it that way)
  taxAmount         BigInt? // GST portion of feeAmount, paise — a subset of it, not additional to it
  capturedAt        DateTime?
  raw               Json?
  createdAt         DateTime  @default(now())

  order           Order?           @relation(fields: [orderId], references: [id])
  settlementLines SettlementLine[]

  @@unique([connectionId, externalPaymentId])
  @@index([organizationId, legalEntityId])
  // The reconciliation items list computes paid-online per order with a
  // lateral aggregate on this FK; without the index that is a sequential
  // scan of payments per order row.
  @@index([orderId])
  // paymentStatus.ts's captured-status filter reasons about "an indexed
  // read" — this is the index that claim needs. Serves the COD-exposure
  // deposits groupBy and the payment reconciliation leg.
  @@index([organizationId, status])
  @@map("payments")
}

model Settlement {
  id                   String    @id @default(cuid())
  organizationId       String
  legalEntityId        String
  connectionId         String
  externalSettlementId String
  amount               BigInt // paise, net settled
  feeAmount            BigInt    @default(0)
  taxAmount            BigInt    @default(0) // GST portion of feeAmount, paise — a subset of it, not additional to it
  utr                  String?
  status               String
  settledAt            DateTime?
  raw                  Json?
  createdAt            DateTime  @default(now())

  // Which provider produced this payout, so a COD remittance from a courier is
  // never confused with a gateway settlement — they reconcile against different
  // things and the amounts are not comparable.
  provider Provider @default(RAZORPAY)
  // The batch's own kind, mirroring its lines. Stored on the parent so the
  // reconciliation engine can select the right batches without joining lines.
  kind     String   @default("GATEWAY") // GATEWAY | COD_REMITTANCE

  lines SettlementLine[]

  @@unique([connectionId, externalSettlementId])
  @@index([organizationId, legalEntityId])
  @@map("settlements")
}

// WHAT A PAYOUT IS MADE OF.
//
// Settlement records the money that arrived; this records WHY. Both of the
// reconciliation legs that could not run were blocked on exactly this and
// nothing else (see modules/calc/reconciliation.ts):
//
//   PAYMENT_SETTLEMENT  "payout composition cannot be inferred from amounts
//                        without guessing"
//   COD_REMITTANCE      "couriers remit many shipments in one transfer, so
//                        individual shipments cannot be tied to a bank credit"
//
// Both are the same missing fact — a payout is a BATCH, and without its line
// items the only way to attribute it is to guess at amounts. One table serves
// both because a gateway settlement report and a courier COD remittance
// statement are the same document: a total, a UTR, and the list of things it
// paid for.
//
// Deliberately not merged into Settlement as a JSON column: these rows are
// joined against Payment and Shipment by the reconciliation engine, and a
// join is not something to do through jsonb when there are hundreds of
// thousands of them.
enum SettlementLineType {
  // A gateway settlement line — one captured payment inside a payout.
  PAYMENT
  // A courier/aggregator COD remittance line — one delivered shipment's cash.
  SHIPMENT_COD
  // Money in the batch with no source row of its own: gateway fees, TDS,
  // chargebacks, RTO freight recovery, shipping charges deducted at source.
  // Modelled explicitly rather than dropped, because a payout whose lines do
  // not sum to its total is indistinguishable from a parsing bug.
  ADJUSTMENT
}

model SettlementLine {
  id             String             @id @default(cuid())
  organizationId String
  settlementId   String
  type           SettlementLineType

  // The identifier the PROVIDER states — an AWB, a gateway payment id, or an
  // adjustment code. Kept verbatim and separately from the resolved FKs below,
  // because a line that fails to resolve is a real and reportable state (the
  // courier remitted for a shipment we have never seen), not a row to discard.
  externalReference String

  // Resolved opportunistically. Null means "stated but not matched to anything
  // we hold" — which the reconciliation engine surfaces rather than hides.
  paymentId  String?
  shipmentId String?

  // Gross is what the line was worth; fee is what the provider took; net is
  // what it contributed to the payout. All three are stored rather than two
  // plus arithmetic, so a provider that reports them inconsistently is caught
  // instead of silently reconciled.
  grossAmount BigInt // paise
  feeAmount   BigInt   @default(0)
  taxAmount   BigInt   @default(0) // GST portion of feeAmount, paise — a subset of it, not additional to it
  netAmount   BigInt // paise
  raw         Json?
  createdAt   DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  payment    Payment?   @relation(fields: [paymentId], references: [id])
  shipment   Shipment?  @relation(fields: [shipmentId], references: [id])

  // Re-importing the same statement must update in place, not stack (§94).
  @@unique([settlementId, type, externalReference])
  @@index([organizationId, type])
  @@index([paymentId])
  @@index([shipmentId])
  @@map("settlement_lines")
}

enum BankTxnDirection {
  CREDIT
  DEBIT
}

model BankTransaction {
  id             String           @id @default(cuid())
  organizationId String
  legalEntityId  String
  connectionId   String
  externalTxnId  String
  amount         BigInt // paise
  direction      BankTxnDirection
  valueDate      DateTime
  description    String?
  utr            String?
  raw            Json?
  createdAt      DateTime         @default(now())

  @@unique([connectionId, externalTxnId])
  @@index([organizationId, legalEntityId])
  // Cash-received sums CREDIT rows per window on every dashboard render, and
  // the trend buckets six months of them — both were org-wide heap filters
  // without this. The [organizationId, direction] prefix also serves the
  // data-status bankCreditCount.
  @@index([organizationId, direction, valueDate])
  @@map("bank_transactions")
}

// Setu's Account Aggregator flow is notification-driven and asynchronous:
// creating a data session (modules/connectors/setu.ts's createDataSession)
// only returns a session id + PENDING status — the actual FI data shows up
// later via a webhook that carries that same session id, not a consent id
// or connection id. This table is the lookup this app owns to map a
// dataSessionId back to the Connection it belongs to when that webhook
// lands (see routes/webhooks/setu.ts). No org/legalEntity columns needed —
// the Connection row looked up via connectionId already carries those.
model BankAaDataSession {
  id           String   @id // Setu's data session id, not ours
  connectionId String
  status       String   @default("PENDING") // mirrors Setu's combined session status: PENDING/PARTIAL/COMPLETED/EXPIRED/FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([connectionId])
  @@map("bank_aa_data_sessions")
}

// Shared by both Meta Ads and Google Ads (see `provider`) — one row per ad
// account per day, not per campaign. A per-campaign breakdown would need a
// nullable externalCampaignId in the unique key, hitting the same Prisma
// nullable-compound-key limitation documented on Connection/MetricSnapshot;
// account-level daily spend is enough to feed a total ad-spend metric, and
// campaign-level detail can be added later without migrating this table if
// it turns out to matter.
model AdSpend {
  id                String   @id @default(cuid())
  organizationId    String
  legalEntityId     String
  connectionId      String
  provider          Provider // META_ADS or GOOGLE_ADS
  externalAccountId String
  date              DateTime // the day this spend covers, UTC midnight
  spendAmount       BigInt // paise
  impressions       Int?
  clicks            Int?
  currency          String   @default("INR")
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([connectionId, externalAccountId, date])
  @@index([organizationId, legalEntityId])
  @@index([date])
  @@map("ad_spend")
}

// P6.6 — campaign-grain ad spend (§14).
//
// WHY A SEPARATE TABLE AND NOT COLUMNS ON AdSpend
// -----------------------------------------------
// A campaign row is a FINER GRAIN of the same fact, not a different fact. Put
// both in one table and the advertising cost layer — which sums
// AdSpend.spendAmount — silently doubles the moment a campaign pull lands
// alongside an account pull for the same day. Nothing would throw, contribution
// margin would just quietly halve, and the number would look like a bad month.
//
// Keeping them apart makes that impossible: AdSpend stays the authoritative
// account-day total that every cost calculation reads, and this table answers
// "which campaign" without ever being summed into the same place. The two can
// then be CROSS-CHECKED — a campaign total that does not reconcile to its
// account-day total means a pull is incomplete, which is a fact worth knowing
// and would be invisible if they shared a row.
//
// `channel` is nullable on purpose. Meta and Google spend usually drives the
// D2C store, but a brand running Amazon-directed campaigns through Meta is
// ordinary, and guessing would attribute a marketplace's cost to the website.
// Null means "not attributable", and channel profitability reports it as
// unallocated rather than spreading it.
model AdCampaignSpend {
  id                String   @id @default(cuid())
  organizationId    String
  legalEntityId     String
  connectionId      String
  provider          Provider // META_ADS or GOOGLE_ADS
  externalAccountId String
  date              DateTime // the day this spend covers, UTC midnight
  /**
   * The provider's own campaign id — stable across renames.
   */
  campaignId        String
  /**
   * The campaign's name at pull time. Renamed campaigns keep their id.
   */
  campaignName      String?
  /**
   * Sales channel this campaign drove, where the provider states it. Null = not attributable.
   */
  channel           String?
  spendAmount       BigInt // paise
  impressions       Int?
  clicks            Int?
  /**
   * Conversions the ad platform claims. Platform-attributed, NOT our order count — see modules/calc/campaigns.ts.
   */
  conversions       Int?
  /**
   * Revenue the ad platform claims it drove, paise. Same caveat as conversions.
   */
  attributedRevenue BigInt?
  currency          String   @default("INR")
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([connectionId, externalAccountId, campaignId, date])
  @@index([organizationId, legalEntityId])
  @@index([organizationId, date])
  @@index([campaignId])
  @@map("ad_campaign_spend")
}

// First real inventory data source (Shopify's products.json — see
// modules/connectors/shopify/index.ts's pullProducts()). Deliberately
// current-state only, not a time series: each sync overwrites `variants`'
// `inventoryQuantity` in place rather than appending a dated row, same as
// Shopify itself only ever tells you the *current* stock level, not a
// history of it. That means there's no way to compute a "30 days ago"
// comparison for inventory value the way revenue/cash-received can — see
// modules/calc/inventory.ts. Split into Product + ProductVariant (not one
// flat table) because Shopify's own model is two-level: a T-shirt is one
// Product with a ProductVariant per size/color, each with its own SKU,
// price, and stock count.
model Product {
  id                String   @id @default(cuid())
  organizationId    String
  legalEntityId     String
  connectionId      String
  externalProductId String
  title             String
  productType       String?
  vendor            String?
  status            String // Shopify: active | archived | draft
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants ProductVariant[]

  @@unique([connectionId, externalProductId])
  @@index([organizationId, legalEntityId])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  externalVariantId String
  sku               String?
  title             String // e.g. "Small / Red" — Shopify's own variant title, not the product title
  price             BigInt // paise
  // Total across every Shopify location, not location-level detail — this
  // MVP doesn't model multi-location inventory (see modules/calc/inventory.ts).
  inventoryQuantity Int      @default(0)
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, externalVariantId])
  @@index([productId])
  @@map("product_variants")
}

// §57 accounts payable. Vendor bills from an accounting system — the source
// for "upcoming payments" and, with §74 expenses below, for burn and EBITDA.
// Deliberately NOT merged into Payment/Settlement: those are money the business
// RECEIVES; this is money it owes.
model VendorBill {
  id             String    @id @default(cuid())
  organizationId String
  legalEntityId  String
  connectionId   String
  externalBillId String
  billNumber     String
  vendorName     String
  vendorRef      String?
  billDate       DateTime
  dueDate        DateTime?

  // Both stored: §57 is `invoice total − payments applied − credit notes`, and
  // the accounting system has already done that arithmetic in `balance`.
  // Keeping the total alongside it means an ageing report can distinguish "big
  // bill mostly paid" from "small bill untouched".
  totalAmount   BigInt // minor units of `currency`, NOT necessarily paise
  balanceAmount BigInt

  // Zoho organisations can be multi-currency. Stored per row and never summed
  // across currencies without a guard — the same rule modules/calc/ads.ts
  // enforces for ad spend.
  currency  String   @default("INR")
  status    String // draft | open | overdue | paid | void | partially_paid
  raw       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalBillId])
  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@map("vendor_bills")
}

// §74 operating expenses. Categories come from the accounting system's own
// chart of accounts rather than a category list invented here — the whole
// point of connecting accounting is to adopt the books' classification.
model Expense {
  id                String   @id @default(cuid())
  organizationId    String
  legalEntityId     String
  connectionId      String
  externalExpenseId String
  expenseDate       DateTime
  accountName       String // chart-of-accounts head, e.g. "Advertising", "Rent"
  vendorName        String?
  description       String?
  amount            BigInt // minor units of `currency`
  taxAmount         BigInt   @default(0)
  currency          String   @default("INR")
  status            String?
  raw               Json?
  createdAt         DateTime @default(now())

  @@unique([connectionId, externalExpenseId])
  @@index([organizationId, expenseDate])
  @@map("expenses")
}

// §24's cost-source hierarchy, applied to product cost: always expose where a
// number came from, so an estimate is never mistaken for an invoice.
enum CostSource {
  SHOPIFY // pulled from Shopify InventoryItem.cost ("Cost per item")
  MANUAL // entered by a user in the UI
  CSV_IMPORT // bulk upload
  ESTIMATED // derived or assumed — lowest confidence
}

// §19 COGS: product cost as DATE-EFFECTIVE records, never a single mutable
// "current cost" column on the variant. The whole point is that last quarter's
// contribution margin must not change because today's purchase price changed —
// so a new cost is a new row with a new effectiveFrom, and historical orders
// keep resolving against the row that was in force when they were placed.
//
// §20's costing method (Weighted Average / FIFO / Specific Identification)
// is NOT implemented: that needs purchase-lot tracking, which requires purchase
// orders / GRNs this system has no source for. What's here is effectively
// Specific Identification against the effective-dated rate — the honest subset,
// and the spec's own suggested MVP default (Weighted Average) would still need
// lot data to be meaningful.
model ProductCost {
  id             String @id @default(cuid())
  organizationId String

  // SKU is the practical key: it's what a founder has in a spreadsheet and
  // what survives a product being deleted and recreated in Shopify. variantId
  // is resolved opportunistically and may be null for a cost entered before
  // the product has synced.
  sku       String
  variantId String?

  effectiveFrom DateTime

  // §19 landed cost components, stored separately rather than as one total so
  // a founder can see why a unit costs what it does — and so freight/duty can
  // later be revised without losing the purchase price.
  purchaseCost   BigInt // paise
  inboundFreight BigInt @default(0)
  importDuty     BigInt @default(0)
  otherCost      BigInt @default(0)
  // Denormalised sum of the four components above. Stored rather than computed
  // so that a historical row is a fixed record of what was charged, immune to
  // a future change in how landed cost is defined.
  landedCost     BigInt

  currency  String     @default("INR")
  source    CostSource
  note      String?
  createdAt DateTime   @default(now())
  createdBy String?

  // One cost per SKU per effective date — re-uploading the same CSV updates in
  // place instead of stacking duplicate rows (§94 idempotency).
  @@unique([organizationId, sku, effectiveFrom])
  @@index([organizationId, sku, effectiveFrom])
  @@index([variantId])
  @@map("product_costs")
}

enum ShipmentStatus {
  NEW
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED
  LOST
  UNKNOWN
}

// Shipment is deliberately separate from Order (not fields bolted onto it),
// same reasoning as Payment/Settlement being their own tables — a courier's
// view of an order (AWB, status, freight cost) is its own lifecycle that can
// change independently of the order itself, and one order can have more than
// one shipment (split fulfillment, RTO + reshipment).
model Shipment {
  id                 String         @id @default(cuid())
  organizationId     String
  legalEntityId      String
  connectionId       String
  externalShipmentId String
  orderId            String? // matched to our Order via orderNumber; null if unmatched
  awbCode            String?
  courierName        String?
  status             ShipmentStatus @default(UNKNOWN)
  freightAmount      BigInt? // paise — not populated yet, see modules/connectors/shiprocket
  codAmount          BigInt? // paise, cash-on-delivery amount to be collected, if any
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  raw                Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order           Order?           @relation(fields: [orderId], references: [id])
  settlementLines SettlementLine[]

  @@unique([connectionId, externalShipmentId])
  @@index([organizationId, legalEntityId])
  @@index([awbCode])
  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Inbound email ingestion
// ---------------------------------------------------------------------------

// A per-org ingest address, e.g. docs-<token>@in.<domain>. The token is the
// ONLY authentication an inbound email carries — sender addresses are trivially
// forged and no Indian courier signs its mail — so it is long, random, stored
// hashed-equivalent (unguessable, not derived), and rotatable. Rotation is a
// new row rather than an update: mail sent to the old address during the
// changeover window still has to be attributable, and a merchant who rotates
// because the address leaked needs the old one DEAD, which `disabledAt` makes
// explicit rather than implied by overwrite.
model EmailIngestAddress {
  id             String    @id @default(cuid())
  organizationId String
  token          String    @unique
  createdAt      DateTime  @default(now())
  disabledAt     DateTime?

  inboundEmails InboundEmail[]

  @@index([organizationId])
  @@map("email_ingest_addresses")
}

enum InboundEmailStatus {
  PROCESSED // every attachment either imported or was a duplicate
  PARTIAL // some attachments imported, some failed or were unrecognised
  FAILED // attachments present, none imported
  EMPTY // no attachments worth trying (no PDF/CSV)
}

// One row per email received, whatever happened to it. This table is the
// answer to "I forwarded the invoice yesterday, where is it?" — without it a
// silently-dropped attachment is indistinguishable from mail that never
// arrived, and the merchant's only recourse is re-forwarding into the void.
model InboundEmail {
  id              String             @id @default(cuid())
  organizationId  String
  addressId       String
  /**
   * RFC Message-ID when the provider passes one — the dedupe key for retries.
   */
  messageId       String?
  fromAddress     String?
  subject         String?
  attachmentCount Int
  status          InboundEmailStatus
  /**
   * Per-attachment outcomes: [{name, kind, ok, detail}] — what the log renders.
   */
  outcomes        Json
  createdAt       DateTime           @default(now())

  address EmailIngestAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)

  // Providers retry webhook deliveries on timeout; the same email must not
  // import its attachments twice. Message-ID is the natural key when present.
  @@unique([organizationId, messageId])
  @@index([organizationId, createdAt])
  @@map("inbound_emails")
}

// ---------------------------------------------------------------------------
// Courier freight invoices
// ---------------------------------------------------------------------------

// What a courier CHARGED us to carry parcels — distinct in every way from a COD
// remittance, which is what a courier COLLECTED and paid us. Kept in its own
// tables rather than folded into Settlement for exactly that reason: one is a
// cost, the other is a receipt, and a shared table invites summing them.
//
// Persisted rather than being applied straight onto Shipment.freightAmount and
// discarded, because the invoice answers questions the shipment cannot:
//   - which invoice a charge came from, when a figure is disputed
//   - whether an invoice has already been uploaded (re-upload is idempotent)
//   - which AWBs were billed that we have NO shipment for — invisible otherwise
model FreightInvoice {
  id              String    @id @default(cuid())
  organizationId  String
  legalEntityId   String
  connectionId    String
  /**
   * Courier's own invoice number, e.g. "2026709R00005458".
   */
  invoiceNo       String
  invoiceDate     DateTime?
  /**
   * The courier account billed, e.g. "NDA821166".
   */
  customerAccount String?
  /**
   * e.g. "Etail Air COD" / "Etail Air Prepaid" — the COD/prepaid split.
   */
  product         String?
  carrier         String // normalised carrier slug, see connectors/courier.ts
  /**
   * paise — the freight subtotal the invoice itself states.
   */
  statedTotal     BigInt?
  /**
   * paise — grand total incl. surcharges and GST. NOT the sum of the lines.
   */
  grandTotal      BigInt?
  /**
   * paise — sum of the parsed lines. Equals statedTotal or the upload is refused.
   */
  lineTotal       BigInt
  lineCount       Int
  fileName        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines FreightInvoiceLine[]

  // Re-uploading the same PDF must not double-count freight. The courier's own
  // invoice number is the natural key.
  @@unique([organizationId, invoiceNo])
  @@index([organizationId, carrier])
  @@map("freight_invoices")
}

model FreightInvoiceLine {
  id              String   @id @default(cuid())
  organizationId  String
  invoiceId       String
  awb             String
  /**
   * Resolved at apply time. Null means the courier billed for a parcel we have no record of.
   */
  shipmentId      String?
  shipDate        DateTime
  destination     String?
  serviceType     String?
  chargedWeightKg Float?
  /**
   * paise, SIGNED — negative rows are credits the courier issued back.
   */
  amount          BigInt
  /**
   * The courier's (R) prefix: a return leg, billed on top of the outbound one.
   */
  isReturnLeg     Boolean  @default(false)
  createdAt       DateTime @default(now())

  invoice FreightInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, awb])
  @@index([invoiceId])
  @@index([shipmentId])
  @@map("freight_invoice_lines")
}

// ---------------------------------------------------------------------------
// Reconciliation
// ---------------------------------------------------------------------------

enum MatchType {
  ORDER_PAYMENT
  PAYMENT_SETTLEMENT
  SETTLEMENT_BANK
  COD_REMITTANCE
  // Shipment ↔ courier freight invoice line. The only leg that reconciles a
  // COST rather than a receipt, and it runs in both directions: a shipment with
  // no invoice line is freight we have not been billed for yet (or an invoice
  // we have not uploaded), and an invoice line with no shipment is the courier
  // billing for a parcel this system has no record of — which is money leaving
  // for nothing, and the only place it would ever surface.
  SHIPMENT_FREIGHT
  // §15 leg 6. Refund ↔ the gateway line that carries the money back out.
  // Also runs both ways: our refund with no gateway line is money the store
  // believes it returned and the gateway has no record of, and a gateway
  // refund line with no refund of ours is money leaving against an order this
  // system never saw refunded — a chargeback, or a refund issued straight from
  // the gateway dashboard, both of which are invisible everywhere else.
  REFUND_PAYMENT
}

enum MatchConfidence {
  HIGH
  MEDIUM
  LOW
  MANUAL
}

enum MatchStatus {
  MATCHED
  EXCEPTION
  RESOLVED
}

// One row per PAIRING the engine established — never one row per unmatched
// record. Unmatched is the absence of a row, computed with a LEFT JOIN at read
// time (modules/calc/reconciliation.ts), because "unmatched" is not a fact
// about an order, it is a fact about the current state of every OTHER table:
// materialising 49,617 exception rows would mean re-deriving all of them every
// time a single payment arrives.
//
// The one exception is a human WRITE-OFF — "this order will never be paid,
// stop showing it" — which is a decision, not a derivation, so it must be
// stored. That is the only case with a null target.
model ReconciliationMatch {
  id             String          @id @default(cuid())
  organizationId String
  matchType      MatchType
  confidence     MatchConfidence
  sourceType     String
  sourceId       String
  // Nullable ONLY for a written-off source (see above). Every engine-produced
  // match has both sides.
  targetType     String?
  targetId       String?
  amountDeltaAbs BigInt          @default(0) // paise, |source - target|
  status         MatchStatus     @default(MATCHED)
  // Free text on a write-off/resolution, so a decision carries its reason.
  note           String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  // Re-running the engine must be idempotent — it is a pure function of the
  // current tables, so the same pass must upsert the same rows rather than
  // duplicating them. Postgres treats NULLs as distinct, so write-off rows
  // (null target) are deliberately outside this constraint.
  @@unique([matchType, sourceType, sourceId, targetType, targetId], name: "recon_pair")
  @@index([organizationId, status])
  @@index([organizationId, matchType])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@map("reconciliation_matches")
}

// ---------------------------------------------------------------------------
// Computed metrics (output of the deterministic calc engine — the AI CFO and
// dashboard both read from here, never from raw tables directly, so every
// number they show is versioned and reproducible)
// ---------------------------------------------------------------------------

enum MetricGranularity {
  DAILY
  MONTHLY
}

enum MetricConfidence {
  ESTIMATED
  PROVISIONAL
  RECONCILED
  FINAL
}

model MetricSnapshot {
  id             String            @id @default(cuid())
  organizationId String
  legalEntityId  String?
  metricKey      String // e.g. "revenue", "contribution_margin", "cash_forecast_7d"
  granularity    MetricGranularity
  periodStart    DateTime
  periodEnd      DateTime
  valueMinor     BigInt? // paise, for money metrics
  valueNumeric   Float? // for ratios/percentages only — never for currency
  formulaVersion String
  confidence     MetricConfidence  @default(ESTIMATED)
  computedAt     DateTime          @default(now())

  @@unique([organizationId, legalEntityId, metricKey, granularity, periodStart, formulaVersion])
  @@index([organizationId, metricKey, periodStart])
  @@map("metric_snapshots")
}

// ---------------------------------------------------------------------------
// Audit (insert-only — every financial calculation and every user/AI action
// that touches money gets a row here; never update or delete rows in this table)
// ---------------------------------------------------------------------------

enum ActorType {
  USER
  SYSTEM
  AI
}

// The durable half of calcCache — see lib/precomputedStore.ts. Holds the exact
// response body an expensive metric endpoint already produced, keyed by the
// same variant string calcCache builds, so a cold cache costs a table read
// rather than an 810ms scan. Not time-bounded: rows are deleted by
// invalidateOrgReads on every observable write, never aged out, because a
// figure whose inputs changed is wrong rather than stale.
model PrecomputedResponse {
  id             String   @id @default(cuid())
  organizationId String
  // "<metric>|<legalEntityId>/<entityCount>|<canonical query>" — built by
  // variantKey() so this and calcCache cannot drift apart.
  variant        String
  body           String
  computedAt     DateTime @default(now())

  @@unique([organizationId, variant])
  // Invalidation deletes by organisation and nothing else, and it runs on
  // every write path a user can observe.
  @@index([organizationId])
  @@map("precomputed_responses")
}

model AuditLog {
  id             String    @id @default(cuid())
  organizationId String
  actorType      ActorType
  actorId        String
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// §17 anomaly detection. Rule-based (v1, per spec) — modules/calc/anomalies.ts
// is the registry; every value here is computed there, never guessed by a
// route or by the AI layer.
enum AnomalyType {
  REVENUE_DECLINE
  REVENUE_SPIKE
  AD_SPEND_SPIKE
  RTO_INCREASE
  REFUND_INCREASE
  COURIER_COST_INCREASE
  NEGATIVE_MARGIN_SKU
  MISSING_SETTLEMENT
  DUPLICATE_PAYMENT
  CANCELLATION_INCREASE
  PRODUCT_COST_INCREASE
  CASH_BELOW_THRESHOLD
}

enum AnomalySeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Anomaly {
  id             String          @id @default(cuid())
  organizationId String
  type           AnomalyType
  severity       AnomalySeverity

  // Numeric axis of the finding — not always paise (e.g. RTO_INCREASE's
  // values are a rate in percentage points), so plain Float rather than the
  // BigInt-paise convention every money value elsewhere uses. Rules that ARE
  // money-shaped (revenue, ad spend, courier cost, cash) still put the paise
  // figure here as a plain number — safe up to ~9e15, far past anything a
  // D2C brand's numbers reach — and keep the exact BigInt string in evidence.
  observedValue Float
  expectedValue Float
  difference    Float

  periodStart DateTime
  periodEnd   DateTime

  // Rule-specific detail: which SKUs, which orders, the exact paise strings,
  // the query that produced the finding. What recommendedInvestigation below
  // tells a human to go look AT.
  evidence                 Json
  recommendedInvestigation String

  ownerId String? // Clerk user id — unassigned until a human claims it
  status  AnomalyStatus @default(OPEN)

  // One row per (type, org, period) — see modules/calc/anomalies.ts's
  // dedupeKeyFor(). Re-running the same day's check is an upsert, not a
  // second row; a new day is a new period and a new row, which is what lets
  // "since when has this been true" be answered by querying history instead
  // of only ever seeing today's snapshot.
  dedupeKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("anomalies")
}

// ---------------------------------------------------------------------------
// §23 Notifications (P3.1)
// ---------------------------------------------------------------------------
// "Anomalies nobody sees are worthless." The §17 engine has run nightly since
// P2.1c and finds real problems — a below-cost SKU, a settlement that stopped
// arriving — and every one of them waits for someone to open the Exceptions
// page and notice. This table is what turns a finding into something that
// reaches a person.

enum NotificationType {
  ANOMALY_CREATED
  SYNC_FAILED
  DATA_STALE
  RECON_EXCEPTION_SPIKE
  CASH_BELOW_THRESHOLD
  VENDOR_PAYMENT_DUE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id             String               @id @default(cuid())
  organizationId String
  type           NotificationType
  severity       NotificationSeverity
  title          String
  body           String

  // What this is ABOUT, so the UI can link somewhere useful. Deliberately a
  // loose pair rather than six nullable foreign keys: the referenced entity
  // differs per type (an Anomaly, a Connection, a VendorBill), and a column
  // per type would need a migration for every new emitter.
  resourceType String?
  resourceId   String?

  // The same rule the anomaly engine holds to. Emitters are polled — the
  // nightly sweep re-evaluates every condition from scratch — so without this
  // a founder whose cash has been below threshold for three weeks would find
  // twenty-one identical rows waiting. One condition, one row, updated in
  // place while it persists.
  dedupeKey String @unique

  // Null until read. Reading is the ONLY thing a user can do to a
  // notification: there is no delete, because a notification is a record that
  // someone was told, and quietly removing it would make the audit trail lie
  // about what was communicated.
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId, readAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// §13 intelligence entities — the AI CFO's conversation and audit trail (P4.2)
// ---------------------------------------------------------------------------
// §29 requires "AI tool execution" in the audit trail, and that is not
// satisfied by logging the question and the answer. What makes an AI answer
// auditable is knowing which tools it called, with what arguments, and what
// each one returned — because the §19 contract says every figure in an answer
// came from a tool result, and the only way to VERIFY that later is to still
// have the tool results.

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  // Hit the turn or token cap before reaching an answer. Distinct from FAILED:
  // nothing broke, the question was simply bigger than the budget, and the two
  // need different responses from whoever reads the log.
  EXHAUSTED
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

model AgentConversation {
  id             String   @id @default(cuid())
  organizationId String
  // Clerk user id. A conversation belongs to a PERSON within an org, not to
  // the org: two people asking about the same month should not see each
  // other's threads.
  userId         String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages AgentMessage[]
  runs     AgentRun[]

  @@index([organizationId, userId, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String           @id @default(cuid())
  conversationId String
  organizationId String
  role           AgentMessageRole
  content        String
  // The §19 structured answer as returned. Stored whole so a conversation can
  // be re-rendered exactly as it was answered, including its evidence refs and
  // data-status labels — a reply re-derived later from live data would show
  // different numbers under the same question.
  structured     Json?
  createdAt      DateTime         @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model AgentRun {
  id               String         @id @default(cuid())
  conversationId   String
  organizationId   String
  userId           String
  question         String
  status           AgentRunStatus @default(RUNNING)
  model            String
  turns            Int            @default(0)
  // Billed at the full input rate. Excludes cache reads and cache writes,
  // which the API reports separately — see the note below.
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  // Prompt-cache accounting, kept as three separate counters rather than one
  // input total, because they bill at three different rates (~0.1x, ~1.25x and
  // 1x of the input rate) and a sum would hide whether caching is working at
  // all. Rows written before caching was enabled carry 0 in both and are not
  // comparable to later ones: their whole prompt was billed as inputTokens.
  cacheReadTokens  Int            @default(0)
  cacheWriteTokens Int            @default(0)
  error            String?
  // P4.7's verdict on this run's own answer, computed at answer time rather
  // than only in the eval suite. Holds {figures, sources, pii} — which figures
  // could not be found in any tool result, which sources named a tool that
  // does not exist, and whether raw PII survived masking. Stored because "the
  // model made a number up" is the one failure this product cannot detect
  // later from the answer alone: the tool results that would disprove it are
  // on AgentToolCall, but matching them back up after the fact is guesswork.
  verification     Json?
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls    AgentToolCall[]

  @@index([organizationId, startedAt])
  @@map("agent_runs")
}

// P4.5. One AI-written narrative per organisation per day.
//
// Stored rather than generated on request for two reasons that both come down
// to the same thing — a brief is a shared artefact. Two people opening the
// same morning's brief must read the same explanation of the same numbers, and
// a founder who screenshots it must be able to point at what was said. A
// narrative regenerated per page load is neither.
//
// A null narrative with a reason is a normal, expected row: "nothing moved",
// "no snapshot history yet", "the narrative was discarded because it contained
// a figure the snapshot did not produce". Those are answers, and recording
// them stops the sweep retrying a question that already resolved.
// §22 approval engine (P5.2).
//
// The model exists because of a distinction the rest of this system already
// makes everywhere else: a DERIVATION can be recomputed and a DECISION cannot.
// Writing off ₹4 lakh, restamping a cost on a period already reported, or
// sending a message to a vendor are decisions. They are irreversible in the
// way that matters — the ledger, the reported number and the counterparty's
// inbox have all moved on — and the system's only defence against a mistake
// is that a second person looked first.
//
// Everything needed to make that judgement is stored ON the request. A
// reviewer who has to go and reconstruct what they are approving will approve
// it, because the alternative is spending twenty minutes on a checkbox.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  // Nobody acted before the deadline. Distinct from REJECTED: a request that
  // times out was not judged, and treating silence as a "no" hides the fact
  // that the process failed rather than the request.
  EXPIRED
  // Withdrawn by whoever raised it, before anyone acted.
  CANCELLED
}

enum ApprovalRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalActionType {
  // Writing off an unmatched order above the materiality threshold.
  RECONCILIATION_WRITE_OFF
  // Restamping product costs over a period that has already been reported.
  COST_RESTAMP
  // An AI-drafted message to someone outside the company. Draft-only by
  // construction — §18's tool returns text and nothing sends it.
  EXTERNAL_MESSAGE
  // Anything a later consumer adds. Present so a new action type is a code
  // change rather than a migration.
  OTHER
}

// §26/§31 sync history (P5.5).
//
// Connection carries the CURRENT sync state — status, last error, last synced
// at — and that is all it can carry: each field is overwritten by the next
// run. So "this connector has failed four nights running" and "it failed once
// last Tuesday" look identical, and the second is noise while the first is a
// dead feed. The whole point of a per-run row is that the pattern survives.
//
// Also the only place the SHAPE of a sync is recorded: how many records it
// pulled. A run that succeeds and pulls zero records is the signature of an
// expired credential that the provider answers 200 to, and nothing else in
// this system would notice it.
enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  // Ran, completed, and pulled nothing at all. Not a failure — a store with
  // no orders yesterday is a real thing — but distinct from SUCCEEDED so a
  // run of empty nights is visible as a run of empty nights.
  EMPTY
}

enum SyncTrigger {
  // Someone pressed Sync now.
  MANUAL
  // The cadence scheduler.
  SCHEDULED
  // The §12.4 trailing-window repair pass.
  REPAIR
  // First pull after connecting.
  BACKFILL
}

model SyncRun {
  id             String        @id @default(cuid())
  organizationId String
  connectionId   String
  provider       Provider
  trigger        SyncTrigger   @default(SCHEDULED)
  status         SyncRunStatus @default(RUNNING)
  // What the connector said it fetched. Nullable because a failed run does
  // not know, and 0 is a different fact from "unknown".
  recordsFetched Int?
  recordsWritten Int?
  // The cursor this run started from, verbatim. The single most useful field
  // when a sync silently stops advancing: a cursor that never moves explains
  // an empty run that reports success.
  cursor         String?
  error          String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  durationMs     Int?

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([connectionId, startedAt])
  @@map("sync_runs")
}

model ApprovalRequest {
  id             String             @id @default(cuid())
  organizationId String
  actionType     ApprovalActionType
  status         ApprovalStatus     @default(PENDING)
  riskLevel      ApprovalRiskLevel

  // What is being asked for, in one line a reviewer reads first.
  title      String
  // Why. Written by whoever raised it, not generated.
  reason     String
  // The money at stake, paise. Null when the action moves no money (a message).
  amount     BigInt?
  // What the reviewer needs to see, captured AT REQUEST TIME rather than
  // looked up at review time. A figure that changed between the request and
  // the review would be approved on the strength of a number nobody saw.
  evidence   Json?
  // The thing being acted on: an order id, a product id, a conversation id.
  entityType String?
  entityId   String?
  // The payload the action needs if approved — the draft message text, the
  // write-off note. Stored so approval EXECUTES the request rather than
  // authorising a second, unverified attempt at it.
  payload    Json?

  // Who assembled it. Distinct from requestedBy because §22 allows the AI to
  // prepare a request a person then submits — "the model wrote this" is a fact
  // a reviewer is entitled to.
  preparedBy     String
  preparedByType ActorType      @default(USER)
  requestedBy    String
  // The minimum role that may act on this. Stored rather than derived, so a
  // later change to the policy cannot silently lower the bar on requests that
  // are already open.
  requiredRole   MembershipRole
  // Nobody approves their own request. Enforced in code; recorded here so the
  // trail shows who could have.
  decidedBy      String?
  decidedAt      DateTime?
  decisionNote   String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("approval_requests")
}

model AiDailyBrief {
  id               String   @id @default(cuid())
  organizationId   String
  // Day key in the organisation's timezone, YYYY-MM-DD. Not a DateTime: the
  // brief is about a calendar day in Asia/Kolkata, and an instant would shift
  // it by 5.5 hours on any server that thinks in UTC.
  day              String
  narrative        Json?
  reason           String?
  // How many figures the P4.7 harness checked before this was stored. Shown
  // in the UI so it can say the figures were checked rather than assert it.
  figuresChecked   Int      @default(0)
  model            String?
  // What this brief cost, in tokens. Same four counters and the same reasoning
  // as AgentRun — see lib/aiPricing.ts for why cached reads and cache writes
  // stay separate from uncached input rather than being summed.
  //
  // These were missing until the internal console went to build a cost page and
  // found the one AI job that runs unattended was also the only one nobody was
  // counting. A question costs money when somebody chooses to ask it; this runs
  // once per organisation per day forever, so its cost compounds on its own and
  // is exactly the cost that most needs a number against it.
  //
  // NULLABLE, AND NOT DEFAULTED TO ZERO. Same rule as SyncRun.recordsFetched
  // elsewhere in this file: 0 is a different fact from unknown. A brief that
  // short-circuits before ever reaching the API — no snapshot history, nothing
  // moved, no API key configured — genuinely spent nothing, and that zero is a
  // real measurement worth keeping. Rows written before these columns existed
  // spent something nobody counted. Defaulting to 0 would merge the two and
  // quietly drag every average toward free, which is the one direction a cost
  // figure must never be wrong in.
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  version          String   @default("v1")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, day])
  @@index([organizationId, day])
  @@map("ai_daily_briefs")
}

model AgentToolCall {
  id         String   @id @default(cuid())
  runId      String
  toolName   String
  // Exactly what the model asked for. Kept verbatim, including arguments that
  // failed validation — a rejected call is the more interesting record, since
  // it is where a model tried to reach outside its permitted surface.
  arguments  Json
  // What the tool returned, after PII masking. Never the pre-mask value: this
  // table would otherwise become the one place customer names and phone
  // numbers are retained indefinitely, defeating §27's minimisation.
  result     Json?
  ok         Boolean  @default(true)
  error      String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("agent_tool_calls")
}

// ---------------------------------------------------------------------------
// Internal observability
//
// The only tables in this schema that are NOT scoped to an organisation.
//
// Everything else here answers a question a merchant is entitled to ask about
// their own business. These two answer questions only we are entitled to ask —
// how loaded is the box, how slow is an endpoint across all tenants — and a
// tenant column on them would be meaningless at best and a way to leak one
// customer's traffic shape to another at worst. They are read exclusively
// through /internal, behind middleware/requireSuperAdmin.ts.
// ---------------------------------------------------------------------------

// One row per (minute, route, method). NOT one row per request.
//
// Per-request rows were the first design and would have out-written the orders
// table inside a week: this API serves ~20 calls on a single dashboard load,
// and the row would carry no information the aggregate does not. Aggregating in
// memory and flushing once a minute turns unbounded write volume into a bounded
// one — at most (routes x methods) upserts per minute per API process.
//
// The four API cluster workers each keep their own in-memory counters and each
// flush into the same row, which is why every counter below is written with an
// atomic `increment` rather than a read-modify-write. Two workers flushing the
// same minute must add, not race.
model RequestMetric {
  id          String   @id @default(cuid())
  // Truncated to the minute, UTC. The grain of the whole table.
  bucketStart DateTime
  // The Express ROUTE PATTERN, never the request URL: "/metrics/revenue", not
  // "/metrics/revenue?from=2026-08-01". A URL-keyed table would grow a row per
  // distinct query string and per resource id, which is the cardinality
  // explosion that makes metrics tables unusable.
  route       String
  method      String

  count     Int @default(0)
  status2xx Int @default(0)
  status3xx Int @default(0)
  status4xx Int @default(0)
  status5xx Int @default(0)

  // Sum, not mean. A mean cannot be re-aggregated across buckets without
  // weighting, and every reader here re-aggregates.
  totalMs Int @default(0)
  maxMs   Int @default(0)

  // Response-cache outcome, read from the X-Calc-Cache header the cache
  // middleware already sets. Counted here rather than in a separate Redis
  // counter so hit rate and latency for a route come from one row and cannot
  // disagree about how many requests there were.
  cacheHit  Int @default(0)
  cacheMiss Int @default(0)

  // A LATENCY HISTOGRAM, because percentiles do not average.
  //
  // Storing a mean and calling p95 "mean x 2" is the standard way this table
  // gets built and it is worthless on exactly the traffic that matters — a
  // route that is 5ms for 95% of calls and 4s for the rest has a flattering
  // mean and a terrible p95. These are NON-cumulative counts of requests
  // falling in each band; readers cumulate them and interpolate. Bands are
  // fixed, so buckets from different minutes and different processes add.
  le10   Int @default(0)
  le25   Int @default(0)
  le50   Int @default(0)
  le100  Int @default(0)
  le250  Int @default(0)
  le500  Int @default(0)
  le1000 Int @default(0)
  le2500 Int @default(0)
  le5000 Int @default(0)
  leInf  Int @default(0)

  @@unique([bucketStart, route, method])
  @@index([bucketStart])
  @@index([route, bucketStart])
  @@map("request_metrics")
}

// One sample of the machine, once a minute, taken by the worker process.
//
// WHY NOT THE GCP OPS AGENT. It is the better long-term answer and this does
// not replace it — but it is an agent to install and maintain on a box we
// otherwise deploy entirely through compose, and it cannot see inside the
// containers. This reads /proc through Node's own os module, ships with the
// image, and is enough to answer the question that prompted it: how much of
// this machine are we paying for and not using.
//
// WHAT IT CANNOT SEE, stated here so nobody reads more into the numbers than
// they hold: per-container CPU and memory need the Docker socket, which this
// process deliberately does not have. loadavg and memory come from the host's
// /proc and so describe the WHOLE VM, including Postgres, Redis, Caddy and
// both Node processes together. That is the right denominator for "is the box
// full" and the wrong one for "which container is at fault".
model SystemSample {
  id      String   @id @default(cuid())
  takenAt DateTime @default(now())

  // Host-wide, from /proc/loadavg. Divided by cpuCount at read time to get a
  // saturation ratio — load 4.0 on 4 cores is full, on 8 cores is half.
  load1    Float
  load5    Float
  load15   Float
  cpuCount Int

  // Host-wide, bytes. BigInt because 8GB in bytes overflows nothing here but
  // the next machine size up is where a plain Int would start lying.
  memTotal BigInt
  memFree  BigInt

  // The filesystem the containers write to, bytes. Disk is billed on
  // PROVISIONED size, not used, so both halves are needed to price the waste.
  diskTotal BigInt
  diskFree  BigInt

  // This process only. Useful for spotting a leak in the worker itself, which
  // the host-wide figures above would hide inside 8GB of noise.
  procRssBytes  BigInt
  procHeapBytes BigInt

  @@index([takenAt])
  @@map("system_samples")
}

// One row per (organisation, user, UTC day) they were active on.
//
// Membership.lastSeenAt answers "is this person still around". It cannot answer
// "how many people used this on the 4th", because it holds one instant per
// person and is overwritten — yesterday's actives are unrecoverable the moment
// they come back today. A daily-active chart needs presence recorded per day,
// so this records exactly that and nothing more.
//
// PRESENCE ONLY — deliberately no request counter. The write is throttled to
// once per five minutes per user per process (middleware/lastSeen.ts), and the
// API runs four processes, so any counter here would be a count of throttle
// windows multiplied by however many workers happened to serve the person. That
// is a number that looks like engagement and is really a load-balancing
// artefact. Presence is exact; a count would be noise wearing a number's
// clothes.
model UserActivityDay {
  id             String   @id @default(cuid())
  organizationId String
  clerkUserId    String
  // YYYY-MM-DD, UTC. Not the organisation's local day: this table is read only
  // by the cross-tenant internal console, where a figure cut on each tenant's
  // own midnight cannot be summed across tenants without double-counting the
  // overlap.
  day            String
  lastSeenAt     DateTime

  @@unique([organizationId, clerkUserId, day])
  @@index([day])
  @@map("user_activity_days")
}
