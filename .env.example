DATABASE_URL="postgresql://cfoos:cfoos@localhost:5432/cfoos"
REDIS_URL="redis://localhost:6379"
PORT=4000

# Auth (Clerk) — server-side verification only, never trust client-sent org/role claims
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Signing secret for the Clerk webhook endpoint (Dashboard -> Webhooks -> your endpoint -> Signing Secret)
CLERK_WEBHOOK_SECRET=

# AI CFO (P4) — console.anthropic.com -> API keys. Optional: unset means /ai
# and the daily brief return a stated "not configured" reason instead of a 500,
# and every other route is unaffected. The LLM never calculates money; it reads
# figures this backend already computed.
ANTHROPIC_API_KEY=
# Optional. The AI CFO's agentic loop — picks tools and builds date ranges.
# Defaults to claude-sonnet-5. Change only with an eval run behind it
# (npm run eval): a weaker model spends EXTRA turns, and each turn resends the
# whole prompt, so a cheaper model can bill more than a dearer one.
AI_MODEL=
# Optional. The daily brief only — no tools, a fixed pre-formatted input, and a
# verifier that rejects the narrative if a figure does not check out. Defaults
# to claude-haiku-4-5-20251001. Separate from AI_MODEL so raising the AI CFO's
# tier does not silently raise this one, which runs per org per day forever.
AI_BRIEF_MODEL=

# Encrypts every connector's stored credential. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Shopify Partner app (Partners dashboard -> Apps -> your app -> Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Signing secret for the Shopify webhook subscription
SHOPIFY_WEBHOOK_SECRET=
# Dev/testing only — leave unset for a real deployment. Caps orders and
# products pulled per backfill/sync run (independently) so a large real
# store can be verified quickly instead of waiting through a full pull.
SHOPIFY_BACKFILL_MAX_RECORDS=

# Setu Account Aggregator (FIU) app — Bridge console (bridge.setu.co) -> your product -> API credentials
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# Defaults to Setu's sandbox host if unset — override once you have production credentials
SETU_BASE_URL=https://fiu-sandbox.setu.co
# Our own shared secret, not issued by Setu — append as ?key=<this value> to the notification
# URL you register on the Bridge console (Setu has no webhook signature scheme of its own)
SETU_WEBHOOK_SECRET=

# Optional. Enables the one-click "Explore the demo" button on /login by naming
# the account it signs in. Its PRESENCE is the switch: unset (the default, and
# what a real deployment wants) makes POST /auth/demo-login return 404 and the
# button hide itself.
#
# Setting this lets ANYONE who reaches the login page read that organisation's
# books, and spend your Anthropic tokens asking the AI CFO. The route refuses
# to issue a session if the account is OWNER or ADMIN. See routes/demoLogin.ts.
DEMO_LOGIN_EMAIL=
